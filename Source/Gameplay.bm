Sub TakeBlock (m As LevelMap, p As Square)
    Let m.Topo(p.col, p.row) = TILE_NOTHING
    Let Dodu.HasBlock = TRUE
    ClearSpriteSquare p
End Sub

Sub ThrowRope (m As LevelMap, p As Square, origin As Square, flipped As Integer)
	SpriteSequence_Copy SpriteLevel(DEPTH_LEVEL, p.col, p.row), SprThrownRope(Abs(p.col - origin.col) - 1)
    'Let SpriteLevel(DEPTH_LEVEL, p.col, p.row) = SprThrownRope(Abs(p.col - origin.col) - 1)
    Let SpriteLevel(DEPTH_LEVEL, p.col, p.row).Flipped = flipped
    PrintConsole str$(flipped)
    PrintConsole Square_ToString(p)
    SpriteSequence_Start SpriteLevel(DEPTH_LEVEL, p.col, p.row)
End Sub

Sub DeployRope (m As LevelMap, p As Square)
	ClearSpriteSquare p
	SetSpriteSquare m, FALSE, p.col, p.row, TILE_BLOCK_HOOK
	Let m.Topo(p.col, p.row) = TILE_BLOCK_HOOK
	Dim k As Integer
	If p.col > 0 _AndAlso m.Topo(p.col - 1, p.row) = TILE_NOTHING Then
		' The gap is on the left
		For k = _Clamp(0, MAP_WIDTH - 1, p.col - 1) To _Clamp(0, MAP_WIDTH - 1, p.col - 3) Step -1
			If m.Topo(k, p.row) = TILE_NOTHING Then
				Let m.Topo(k, p.row) = TILE_ROPE
				SetSpriteSquare m, FALSE, k, p.row, TILE_ROPE
			Else
				Exit For
			End If
		Next
	ElseIf p.col < MAP_WIDTH - 1 _AndAlso m.Topo(p.col + 1, p.row) = TILE_NOTHING Then
		' The gap is on the right
		For k = _Clamp(0, MAP_WIDTH - 1, p.col + 1) To _Clamp(0, MAP_WIDTH - 1, p.col + 3) Step 1
			If m.Topo(k, p.row) = TILE_NOTHING Then
				Let m.Topo(k, p.row) = TILE_ROPE
				SetSpriteSquare m, FALSE, k, p.row, TILE_ROPE
			Else
				Exit For
			End If
		Next
	End If
End Sub

Sub PullRope (m As LevelMap, hook_p As Square, feet_p As Square, flipped As Integer)
	PrintLevelConsole m
	Dim clearp As Square
	ClearSpriteSquare hook_p
	Let m.Topo(hook_p.col, hook_p.row) = TILE_BLOCK_B
	Dim direction As Integer, length As Integer, k As Integer
	If hook_p.col > 0 _AndAlso m.Topo(hook_p.col - 1, hook_p.row) = TILE_ROPE Then
		Let direction = -1
	ElseIf hook_p.col < m.Width - 1 _AndAlso m.Topo(hook_p.col + 1, hook_p.row) = TILE_ROPE Then
		Let direction = 1
	End If
	For k = 1 To 3
		If hook_p.col + (k * direction) < m.Width - 1 And hook_p.col + (k * direction) > 0 Then
			If m.Topo(hook_p.col + (k * direction), hook_p.row) = TILE_ROPE Then
				Square_Set clearp, hook_p.col + (k * direction), hook_p.row
				Let length = length + 1
				Let m.Topo(hook_p.col + (k * direction), hook_p.row) = TILE_NOTHING
				ClearSpriteSquare clearp
				PrintConsole "Clearing " + Square_ToString(clearp)
			End If
		Else
			Exit For
		End If
	Next
	PrintLevelConsole m
	PrintConsole "ROPELEN" + Str$(length)
	Dim flip As Integer, hookornot As Integer
	If feet_p.col < hook_p.col Or (feet_p.col = hook_p.col And Not flipped) Then
		PrintConsole "Player at left"
		If direction = 1 Then ' pulling on the hook from the left
			Let flip = TRUE
			Let hookornot = TRUE
		Else ' pulling on the other end from the left
			Let flip = TRUE
			Let hookornot = FALSE
		End If
	Else
		PrintConsole "Player at right"
		If direction = 1 Then ' pulling on the other end from the right
			Let flip = FALSE
			Let hookornot = FALSE
		Else ' pulling on the hook from the right
			Let flip = FALSE
			Let hookornot = TRUE
		End If
	End If
	PrintConsole "Direction: " + Str$(direction) + " Flip: " + Str$(flip) + " Pulling hook: " + Str$(hookornot)
	SpriteSequence_Copy SpriteLevel(DEPTH_LEVEL, hook_p.col, hook_p.row), SprPulledRope(Abs(length) - 1, Abs(hookornot))
	Let SpriteLevel(DEPTH_LEVEL, hook_p.col, hook_p.row).Flipped = flip
	SpriteSequence_Start SpriteLevel(DEPTH_LEVEL, hook_p.col, hook_p.row)
End Sub

Sub TakeTuque (m As LevelMap, p As Square)
    Let m.Topo(p.col, p.row) = TILE_NOTHING
    Let Dodu.HasTuque = TRUE
    ClearSpriteSquare p
    If Not Dodu.HasBlock Then
        Let Dodu.ThermoTick.Speed = THERMO_TICK_NORMAL_TUQUE
    End If
End Sub

Sub TakeCookie (m As LevelMap, p As Square)
    Let m.Topo(p.col, p.row) = TILE_NOTHING
    ClearSpriteSquare p
    PrintConsole "Before cookie: " + Str$(Dodu.Temp)
    Let Dodu.Temp = Clamp%(Dodu.Temp + 5, 0, 10)
    Ticker_Reset Dodu.ThermoTick
    Ticker_Start Dodu.ThermoTick
    PrintConsole "After cookie: " + Str$(Dodu.Temp)
End Sub

Sub TakeCoffee (m As LevelMap, p As Square)
    Let m.Topo(p.col, p.row) = TILE_NOTHING
    ClearSpriteSquare p
    Let Dodu.Temp = Clamp%(Dodu.Temp + 7, 0, 10)
End Sub

Sub TakeMittens (m As LevelMap, p As Square)
    Let m.Topo(p.col, p.row) = TILE_NOTHING
    ClearSpriteSquare p
    Let Dodu.HasMittens = TRUE
    If Dodu.HasBlock Then
        Let Dodu.ThermoTick.Speed = THERMO_TICK_FAST_MITTENS
    End If
End Sub

Sub TakeBackpack (m As LevelMap, p As Square)
    Let m.Topo(p.col, p.row) = TILE_NOTHING
    ClearSpriteSquare p
    Let Dodu.HasBackpack = 2
End Sub

Function PlayerChanged (p_now As Player, p_past As Player)
    Let PlayerChanged = Not (p_now.IsLooking = p_past.IsLooking And p_now.IsPanting = p_past.IsPanting And p_now.HasBlock = p_past.HasBlock And p_now.HasMittens = p_past.HasMittens And p_now.HasTuque = p_past.HasTuque And p_now.IsWalking = p_past.IsWalking And p_past.InSnow = p_now.InSnow And p_past.HasBackpack = p_now.HasBackpack And p_past.IsThrowing = p_now.IsThrowing And p_past.IsReclaiming = p_now.IsReclaiming)
End Function

Sub Player_Reset (p As Player)
    Let p.Temp = 10
    Let p.HasBlock = FALSE
    Let p.IsWalking = FALSE
    Let p.IsClimbing = FALSE
    Let p.IsFalling = FALSE
    Let p.IsPanting = FALSE
    Let p.IsLooking = FALSE
    Let p.InSnow = FALSE
    Let p.IsThrowing = FALSE
    Let p.IsReclaiming = FALSE
    Ticker_Reset p.ThermoTick
    Ticker_Reset p.SlipTick
    Ticker_Stop p.SlipTick
End Sub
