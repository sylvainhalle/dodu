' --------------------------
' Level data
' --------------------------

'$IncludeOnce

LevelData:

' Backgrounds
' -----------
' 0: blue 1
' 1: blue 2
' 2: cards
' 3: cyan 1
' 4: cyan 2
' 5: falling snow
' 6: pizza 1
' 7: pizza 2
' 8: digits
' 9: night sky

' Songs
' -----
' 0: Dodu
' 1: Yaya
' 2: Pizza
' 3: Cards
' 4: Cutscene 1
' 5: Bière qui roule (Dompierre)
' 6: Pastoral
' 7: Homage to Brubeck
' 8: Kraftwerk

' Level data
' ----------
' Format:
' - first line: background index, foreground index (-1 if none),
'   cutscene index (-1 if none), song index
' - second line: x-y coordinates of the background offset
' - third line: x-y coordinates of the background parallax
' - remaining lines: map
' - last line: "x" to indicate the end of a level; "X" to indicate that
'   this is the last level

' --- Cut scene: walking

Data 0, -1, 0, 0
Data 0, 0
Data 60, 0
Data "             "
Data "             "
Data "@           @"
Data "@   @ * @   @"
Data "@!  @@@@@@  @"
Data "@@@@@@@@@@@@@"
Data "x"


Data 1, -1, -1, 0
Data 0, 0
Data 2, 2
Data "                                       "
Data "                                       "
Data "                                       "
Data "                       @@              "
Data "                      @                "
Data "@   @@@              @     @@         @"
Data "@   @@@@           @@   @@@@@   @     @"
Data "@@@@@@@@@   *     @     @@@    @@  !  @"
Data "@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@"
Data "x"


Data 0, -1, -1, 0
Data 0, 0
Data 2, 2
Data "                                "
Data "                                "
Data "               *                "
Data "          @@@@@@@@@@@@@        @"
Data "        @@@                    @"
Data "@     @@             @@@@      @"
Data "@    @       @@@@@            @@"
Data "@   @  @          @            @"
Data "@@@@@  @          @@@@@@@@@@   @"
Data "@      @                       @"
Data "@      @@@@@@                  @"
Data "@    @@@         @        @    @"
Data "@               @@     @@@@    @"
Data "@            @@@@@             @"
Data "@                              @"
Data "@@@@@                       @@@@"
Data "@                              @"
Data "@                 @@@          @"
Data "@  !              @@@@         @"
Data "@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@"
Data "x"

' --- Cut scene: picking blocks

Data 3, -1, 1, 1
Data 0, 0
Data 2, 2
Data "                  "
Data "                  "
Data "@                @"
Data "@        @@     @@"
Data "@@* #@@  @@@  ! @@"
Data "@@@@@@@@@@@@@@@@@@"
Data "x"


Data 4, -1, -1, 1
Data 0, 0
Data 2, 2
Data "@              "
Data "@              "
Data "@             @"
Data "@       @     @"
Data "@       @ *  #@"
Data "@    @  @@@@@@@"
Data "@    @        @"
Data "@    @        @"
Data "@    @      ! @"
Data "@@@@@@@@@@@@@@@"
Data "x"

Data 3, -1, -1, 1
Data 0, 0
Data 2, 2
Data "@               "
Data "@               "
Data "@               "
Data "@     @    #   @"
Data "@     @#* #@   @"
Data "@     @@@@@@   @"
Data "@ !            @"
Data "@ @            @"
Data "@@@            @"
Data "@@@@@@@@@@@@@@@@"
Data "x"

Data 4, -1, -1, 1
Data 0, 0
Data 2, 2
Data "@   @                    "
Data "@  @@@@@                 "
Data "@   @        *           "
Data "@        @@@@@@@@       @"
Data "@                       @"
Data "@                       @"
Data "@            @          @"
Data "@       @    @        ##@"
Data "@      @@    @       ##@@"
Data "@@@   @@@ !  @      ##@@@"
Data "@@@@@@@@@@@@@@@@@@@@@@@@@"
Data "x"

Data 3, -1, -1, 1
Data 0, 0
Data 2, 2
Data "                                          "
Data "                                          "
Data "      * #                                 "
Data "     @@@@@                                "
Data "@                                         "
Data "@                         @      @@      @"
Data "@        @    @    @@    @@@    @@@@     @"
Data "@ !      @@  @@@  @@@@  @@@@@  @@@@@@  ! @"
Data "@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@"
Data "x"

' --- Cut scene: cookies

Data 6, -1, 2, 2
Data 0, 0
Data 2, 2
Data "                            "
Data "                            "
Data "                            "
Data "@                  @       @"
Data "@ !              @@@@@     @"
Data "@@@@@      c    @@@@@@ * ##@"
Data "@@@@@@~@@@@@@@@@@@@@@@@@@@@@"
Data "x"


Data 7, -1, -1, 2
Data 0, 0
Data 2, 2
Data "                   "
Data "@                  "
Data "@                  "
Data "@#            @   @"
Data "@@#        c# @   @"
Data "@@##  *    @@ @ ! @"
Data "@@@@@@@@~@~@@@@@@@@"
Data "x"


Data 6, -1, -1, 2
Data 0, 0
Data 2, 2
Data "                   "
Data "                   "
Data "         *         "
Data "        @@@        "
Data "@        @        @"
Data "@    @@@@@@@@@    @"
Data "@      @@@        @"
Data "@        @        @"
Data "@        @        @"
Data "@        @   @@@@@@"
Data "@@@@@@   @        @"
Data "@        @        @"
Data "@        @        @"
Data "@    @@@@@@@@     @"
Data "@        @        @"
Data "@        @        @"
Data "@        @     @@@@"
Data "@@@@@@            @"
Data "@                 @"
Data "@           c     @"
Data "@    @@  @@@@@@@  @"
Data "@    @@@@@        @"
Data "@        @@       @"
Data "@                 @"
Data "@                 @"
Data "@        !        @"
Data "@        @        @"
Data "@   #    @    #   @"
Data "@  ##    @    ##  @"
Data "@####    @    ####@"
Data "@@@@@@@@~@~@@@@@@@@"
Data "x"

Data 7, -1, -1, 2
Data 0, 0
Data 2, 2
Data "                    "
Data "                   @"
Data "@                 #@"
Data "@    @   @#      ##@"
Data "@!   @   @c# *  ##@@"
Data "@@@@@@~~~@@@@@@@@@@@"
Data "x"

Data 6, -1, -1, 2
Data 0, 0
Data 2, 2
Data "@                       "
Data "@                       "
Data "@     #                 "
Data "@ c   @     #     !     "
Data "@@@@@@@    ##  @  @    @"
Data "@@@@@@@#*  ##  @  @    @"
Data "@@@@@@@@@@@@@@@@@@@~~~~@"
Data "x"

' --- Cut scene: snow

Data 9, -1, 3, 7
Data 0, 0
Data 2, 2
Data "                                  "
Data "                                  "
Data "                                  "
Data "                  !               "
Data "@                SSSSSSSSSS     @@"
Data "@   *    SSS   SSSSSSSSSSSSS   !@@"
Data "@@@@@@SSSSSSSSSSSSSSSSSSSSSSSSSS@@"
Data "x"

' --- Cut scene: mittens

Data 5, -1, 3, 7
Data 0, 0
Data 2, 2
Data "                    @"
Data "                    @"
Data "@                  !@"
Data "@c        @        @@"
Data "@#   @#   @##      @@"
Data "@### @#* #@##m  @@@@@"
Data "@@@@@@@@@@@@@@@@@@@@@"
Data "x"

Data 5, -1, 3, 7
Data 0, 0
Data 2, 2
Data "@                                "
Data "@                                "
Data "@                                "
Data "@ ! SSSS          *      c       "
Data "@@@@SSSSSSSS      ##     @     t@"
Data "@SSSSSSSSSSSS f  ####   S@#  @@@@"
Data "@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@"
Data "X"

' :mode=visualbasic: