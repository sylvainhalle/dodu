Sub ClimbableSquare (side As Integer, lp As Point, m As LevelMap, p As Square)
    Dim col As Integer, row As Integer, x As Integer, overlap As Integer

    Let p.col = -1
    Let p.row = -1

    ' Leading edge after the next movement
    If side Then ' left
        Let x = lp.x - WALKING_SPEED
        Let col = Floor%((x - 1) / BLOCK_SIZE)
        Let overlap = (col + 1) * BLOCK_SIZE - x
    Else ' right
        Let x = lp.x + PLAYER_WIDTH + WALKING_SPEED
        Let col = Floor%(x / BLOCK_SIZE)
        Let overlap = x - col * BLOCK_SIZE
    End If

    ' Still within the permitted penetration
    If overlap <= 2 Then Exit Sub

    If col < 0 Or col >= MAP_WIDTH Then Exit Sub

    Let row = Ceil%((lp.y + PLAYER_HEIGHT) / BLOCK_SIZE) - 1
    If row < 3 Or row >= MAP_HEIGHT Then Exit Sub

    ' A block must be present at foot level
    If Not IsBlockAt(col, row, m) Then Exit Sub

    ' Dodu is three blocks high: the destination column
    ' must be clear above the block
    If IsBlockAt(col, row - 1, m) Then Exit Sub
    If IsBlockAt(col, row - 2, m) Then Exit Sub
    If IsBlockAt(col, row - 3, m) Then Exit Sub

    Let p.col = col
    Let p.row = row - 1
End Sub

Sub TakeableSquare (side As Integer, lp As Point, m As LevelMap, p As Square)
    Dim col As Integer, row As Integer

    Let p.col = -1
    Let p.row = -1

    If Dodu.HasBlock Then Exit Sub

    Let col = SideColumn%(side, lp, TAKE_THRESHOLD)
    If col < 0 Or col >= MAP_WIDTH Then Exit Sub

    Let row = Ceil%((lp.y + PLAYER_HEIGHT) / BLOCK_SIZE) - 1
    If row < 1 Or row >= MAP_HEIGHT Then Exit Sub

    ' There must be a block beside Dodu
    If Not IsWhiteBlockAt(col, row, m) Then Exit Sub

    ' And no block may be resting on it
    If IsWhiteBlockAt(col, row - 1, m) Then Exit Sub

    Let p.col = col
    Let p.row = row
End Sub

' Game state
Sub DroppableSquare (side As Integer, lp As Point, m As LevelMap, p As Square)
    Dim col As Integer, row As Integer
    Dim r As Integer

    Let p.col = -1
    Let p.row = -1

    If Not Dodu.HasBlock Then Exit Sub

    Let col = SideColumn%(side, lp, DROP_THRESHOLD)
    If col < 0 Or col >= MAP_WIDTH Then Exit Sub

    Let row = Ceil%((lp.y + PLAYER_HEIGHT) / BLOCK_SIZE) - 1
    If row < 0 Or row > m.Height Then Exit Sub

    ' If a block is already beside Dodu, try putting
    ' the carried block on top of it.
    If IsBlockAt(col, row, m) Then
        If row > 0 And Not IsBlockAt(col, row - 1, m) Then
            Let p.col = col
            Let p.row = row - 1
        End If
        Exit Sub
    End If

    ' Otherwise find the first supporting block below.
    For r = row + 1 To MAP_HEIGHT - 1
        If IsBlockAt(col, r, m) Then
            Let p.col = col
            Let p.row = r - 1
            Exit Sub
        ElseIf r = m.Height - 1 Then
            Let p.col = col
            Let p.row = r
            Exit Sub
        End If
    Next
End Sub

Sub UnclimbableSquare (side As Integer, lp As Point, m As LevelMap, p As Square)
    Dim col As Integer, row As Integer, x As Integer, overlap As Integer
    Dim r As Integer

    Let p.col = -1
    Let p.row = -1

    ' Leading edge after the next movement
    If side Then ' left
        Let x = lp.x - WALKING_SPEED
        Let col = Floor%((x - 1) / BLOCK_SIZE)
        Let overlap = (col + 1) * BLOCK_SIZE - x
    Else ' right
        Let x = lp.x + PLAYER_WIDTH + WALKING_SPEED
        Let col = Floor%(x / BLOCK_SIZE)
        Let overlap = x - col * BLOCK_SIZE
    End If

    ' Still within the permitted penetration
    If overlap <= UNCLIMB_THRESHOLD Then Exit Sub

    If col < 0 Or col >= MAP_WIDTH Then Exit Sub

    Let row = Ceil%((lp.y + PLAYER_HEIGHT) / BLOCK_SIZE)
    If row < 0 Or row >= MAP_HEIGHT Then Exit Sub
    If IsBlockAt(col, row, m) Or IsRopeAt(col, row, m) Then Exit Sub

    ' Otherwise find the first supporting block below.
    For r = row + 1 To MAP_HEIGHT - 1
        If IsEmptyAt(col, r, m) Then
            Let p.col = col
            Let p.row = r - 1
            Exit Sub
        End If
    Next
End Sub

Function SideColumn% (side As Integer, lp As Point, threshold As Integer)
    Dim x As Integer, grid As Integer

    Let SideColumn% = -1
    If side Then ' left
        Let x = lp.x
        'Let grid = Floor(x / BLOCK_SIZE%) * BLOCK_SIZE%
    Else ' right
        Let x = lp.x + PLAYER_WIDTH
        'Let grid = CInt(x / BLOCK_SIZE%) * BLOCK_SIZE%
    End If

    ' Find the nearest vertical grid line

    Let grid = CInt(x / BLOCK_SIZE) * BLOCK_SIZE

    ' The edge of Dodu may be on either side of that line
    If Abs(x - grid) > threshold Then Exit Function

    If side Then ' left
        Let SideColumn% = (grid \ BLOCK_SIZE) - 1
    Else ' right
        Let SideColumn% = grid \ BLOCK_SIZE
    End If
End Function

Sub BlockingSquare (side As Integer, lp As Point, m As LevelMap, p As Square)
    Dim x As Integer
    Dim col As Integer
    Dim feet As Integer
    Dim overlap As Integer

    Let p.col = -1
    Let p.row = -1

    ' Leading edge after the next movement
    If side Then ' left
        Let x = lp.x - WALKING_SPEED
        Let col = Floor%((x - 1) / BLOCK_SIZE)
        Let overlap = (col + 1) * BLOCK_SIZE - x
    Else ' right
        Let x = lp.x + PLAYER_WIDTH + WALKING_SPEED
        Let col = Floor%(x / BLOCK_SIZE)
        Let overlap = x - col * BLOCK_SIZE
    End If

    ' Still within the permitted penetration
    If overlap <= 4 Then Exit Sub

    If col < 0 Or col >= MAP_WIDTH Then Exit Sub

    Let feet = Ceil%((lp.y + PLAYER_HEIGHT) / BLOCK_SIZE) - 1

    ' Check the two rows alongside Dodu
    If feet >= 1 Then
        If IsBlockAt(col, feet - 1, m) Then
            Let p.col = col
            Let p.row = feet - 1
            Exit Sub
        End If
    End If
    If feet < 3 And IsObstacleAt(col, feet, m) Then ' 3, since otherwise Dodu cannot climb
        Let p.col = col
        Let p.row = feet
        Exit Sub
    End If
End Sub

Sub PoleSquare (side As Integer, lp As Point, m As LevelMap, p As Square)
    Let p.col = -1
    Let p.row = -1
    ' Leading edge after the next movement
    Dim x As Integer, col As Integer, overlap As Integer, feet As Integer
    If side Then ' left
        Let x = lp.x - WALKING_SPEED
        Let col = Floor%((x - 1) / BLOCK_SIZE)
        Let overlap = (col + 1) * BLOCK_SIZE - x
    Else ' right
        Let x = lp.x + PLAYER_WIDTH + WALKING_SPEED
        Let col = Floor%(x / BLOCK_SIZE)
        Let overlap = x - col * BLOCK_SIZE
    End If

    ' Still within the permitted penetration
    If overlap <= 5 Then Exit Sub

    If col < 0 Or col >= MAP_WIDTH Then Exit Sub

    Let feet = Ceil%((lp.y + PLAYER_HEIGHT) / BLOCK_SIZE) - 1

    If IsGoalAt(col, feet, m) Then
        Let p.col = col
        Let p.row = feet
    End If
End Sub

Function IsOnGround% (lp As Point, m As LevelMap)
    Dim row As Integer, col As Integer
    Let IsOnGround = FALSE
    If (lp.y + PLAYER_HEIGHT) Mod 11 <> 0 Then
        Exit Function
    End If
    Let row = Ceil((lp.y + PLAYER_HEIGHT) / BLOCK_SIZE)
    Let col = Floor((lp.x + 6) / BLOCK_SIZE)
    If IsBlockAt(col, row, m) Or IsRopeAt(col, row, m) Then
        Let IsOnGround = TRUE
        Exit Function
    End If
    Let Col = Floor((lp.x + PLAYER_WIDTH - 6) / BLOCK_SIZE)
    If IsBlockAt(col, row, m) Or IsRopeAt(col, row, m) Then
        Let IsOnGround = TRUE
        Exit Function
    End If
End Function

Sub FeetSquare (side As Integer, lp As Point, m As LevelMap, p As Square)
    Dim x As Integer
    Dim col As Integer
    Dim feet As Integer
    Dim overlap As Integer

    Let p.col = -1
    Let p.row = -1

    ' Leading edge after the next movement
    If side Then ' left
        Let x = lp.x - WALKING_SPEED
        Let col = Floor%((x - 1) / BLOCK_SIZE)
        Let overlap = (col + 1) * BLOCK_SIZE - x
    Else ' right
        Let x = lp.x + PLAYER_WIDTH + WALKING_SPEED
        Let col = Floor%(x / BLOCK_SIZE)
        Let overlap = x - col * BLOCK_SIZE
    End If

    ' Still within the permitted penetration
    If overlap <= 4 Then Exit Sub

    If col < 0 Or col >= MAP_WIDTH Then Exit Sub

    Let feet = Ceil%((lp.y + PLAYER_HEIGHT) / BLOCK_SIZE)

    ' Check the two rows alongside Dodu
    If feet >= 1 Then
        Let p.col = col
        Let p.row = feet - 1
        Exit Sub
    End If
    If feet < 3 Then ' 3, since otherwise Dodu cannot climb
        Let p.col = col
        Let p.row = feet
        Exit Sub
    End If
End Sub

Sub MittensSquare (side As Integer, lp As Point, m As LevelMap, p As Square)
    FeetSquare side, lp, m, p
    If p.col < 0 Or p.row < 0 Then
        Exit Sub
    End If
    If Not IsMittenAt(p.col, p.row, m) Then
        Let p.col = -1
        Let p.row = -1
    End If
End Sub

Sub SnowSquare (side As Integer, lp As Point, m As LevelMap, p As Square)
    FeetSquare side, lp, m, p
    If p.col < 0 Or p.row < 0 Or p.row > m.Height - 2 Then
        Exit Sub
    End If
    Let p.row = p.row + 1
    If Not IsSnowAt(p.col, p.row, m) Then
        Let p.col = -1
        Let p.row = -1
    End If
End Sub

Sub TuqueSquare (side As Integer, lp As Point, m As LevelMap, p As Square)
    FeetSquare side, lp, m, p
    If p.col < 0 Or p.row < 0 Then
        Exit Sub
    End If
    If Not IsTuqueAt(p.col, p.row, m) Then
        Let p.col = -1
        Let p.row = -1
    End If
End Sub

Sub CookieSquare (side As Integer, lp As Point, m As LevelMap, p As Square)
    FeetSquare side, lp, m, p
    If p.col < 0 Or p.row < 0 Then
        Exit Sub
    End If
    If Not IsCookieAt(p.col, p.row, m) Then
        Let p.col = -1
        Let p.row = -1
    End If
End Sub

Sub CoffeeSquare (side As Integer, lp As Point, m As LevelMap, p As Square)
    FeetSquare side, lp, m, p
    If p.col < 0 Or p.row < 0 Then
        Exit Sub
    End If
    If Not IsCoffeeAt(p.col, p.row, m) Then
        Let p.col = -1
        Let p.row = -1
    End If
End Sub

Sub ThrowSquare (side As Integer, lp As Point, m As LevelMap, p As Square)
	Dim sign As Integer
	If side Then Let sign = -1 Else Let sign = 1
    FeetSquare side, lp, m, p
    If p.col < 0 Or p.row < 0 Then
        Exit Sub
    End If
	If Not IsEmptyAt(p.col, p.row, m) Then
		Let p.col = -1
		Let p.row = -1
		PrintConsole "NOT EMPTY"
	End If
    Dim k As Integer
    For k = 1 To 4
    	If p.col + (sign * k) >= 0 _AndAlso p.col + (sign * k) < m.Width _AndAlso IsIceBlockAt(p.col + (k * sign), p.row + 1, Levels(CurrentLevel)) Then
    		Let p.col = p.col + (k * sign)
    		Let p.row = p.row + 1
    		Exit Sub
    	End If
    Next
    ' Gap too wide
    Let p.col = -1
    Let p.row = -1
End Sub

Sub PullSquare (side As Integer, lp As Point, m As LevelMap, p As Square)
	Dim k As Integer, ft As Square, sign As Integer
	FeetSquare side, lp, m, ft
	Let ft.row = ft.row + 1
	Square_Set p, -1, -1
	If Not Square_IsValid(ft) Then Exit Sub
	If m.Topo(ft.col, ft.row + 1) = TILE_ROPE Then Exit Sub
	If side Then ' player facing left
		If ft.col = 0 Then
			Exit Sub
		End If
		Let sign = -1
	Else ' player facing right
		If ft.col = m.Width - 1 Then
			Exit Sub
		End If
		Let sign = 1
	End If
	For k = 0 To 4
		'PrintConsole Str$(ft.col + (k * sign))
		If _Clamp(0, m.Width - 1, ft.col + (k * sign)) = ft.col + (k * sign) _AndAlso m.Topo(ft.col + (k * sign), ft.row) = TILE_BLOCK_HOOK Then
			Square_Set p, ft.col + (k * sign), ft.row
			Exit For
		End If
	Next
End Sub
