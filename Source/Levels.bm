Sub Square_Set (s As Square, col As Integer, row As Integer)
    Let s.col = col
    Let s.row = row
End Sub

Function Square_IsValid% (s as Square)
    If s.col >= 0 _AndAlso s.col < M_W% _AndAlso s.row >= 0 _AndAlso s.row < M_H% Then
        Square_IsValid% = TRUE
    Else
        Square_IsValid% = FALSE
    End If
End Function

Sub Level_GoalSquare(l As LevelMap, s As Square)
	Dim r As Integer, c As Integer
	For r = 0 To l.Height
		For c = 0 To l.Width
			If IsGoalAt(c, r, l) Then
				Let s.row = r
				Let s.col = c
				Exit Sub
			End If
		Next
	Next
End Sub

Sub Square_ToPoint (s as Square, p as Point)
    let p.x = s.col * BLOCK_SIZE%
    let p.y = s.row * BLOCK_SIZE%
End Sub

Function IsGoalAt (col As Integer, row As Integer, l As LevelMap)
  If col >= 0 _AndAlso col < M_W% _AndAlso row >= 0 _AndAlso row < M_H% Then
    If l.Topo(col, row) = T_POLE Then
        Let IsGoalAt = TRUE
        Exit Function
    End If
  End If
  Let IsGoalAt = FALSE
End Function

Function IsBlockAt (col As Integer, row As Integer, l As LevelMap)
  If l.Topo(col, row) = T_BLOCK_B Or l.Topo(col, row) = T_BLOCK_W Or l.Topo(col, row) = T_SNOW Then
    Let IsBlockAt = TRUE
  Else
    Let IsBlockAt = FALSE
  End If
End Function

Function IsWhiteBlockAt (col As Integer, row As Integer, l As LevelMap)
  If l.Topo(col, row) = T_BLOCK_W Then
    Let IsWhiteBlockAt = TRUE
  Else
    Let IsWhiteBlockAt = FALSE
  End If
End Function

Function IsObstacleAt (col As Integer, row As Integer, l As LevelMap)
  If l.Topo(col, row) = T_BLOCK_B Or l.Topo(col, row) = T_BLOCK_W Or l.Topo(col, row) = T_SNOW Or l.Topo(col, row) = T_POLE Then
    Let IsObstacleAt = TRUE
  Else
    Let IsObstacleAt = FALSE
  End If
End Function

Function IsCookieAt (col As Integer, row As Integer, l As LevelMap)
  If l.Topo(col, row) = T_COOKIE Then
    Let IsCookieAt = TRUE
  Else
    Let IsCookieAt = FALSE
  End If
End Function

Function IsTuqueAt (col As Integer, row As Integer, l As LevelMap)
  If l.Topo(col, row) = T_TUQUE Then
    Let IsTuqueAt = TRUE
  Else
    Let IsTuqueAt = FALSE
  End If
End Function

Function IsMittenAt (col As Integer, row As Integer, l As LevelMap)
  If l.Topo(col, row) = T_MITTENS Then
    Let IsMittenAt = TRUE
  Else
    Let IsMittenAt = FALSE
  End If
End Function

Function IsSnowAt (col As Integer, row As Integer, l As LevelMap)
  If l.Topo(col, row) = T_SNOW Then
    Let IsSnowAt = TRUE
  Else
    Let IsSnowAt = FALSE
  End If
End Function

' --------------------------
' Loads a level
' --------------------------
Function LoadLevel% (l As LevelMap)
  Dim lline As String, idx As Integer, char As String, row As Integer, bg As Integer, cutscene As Integer, songindex As Integer
  Read bg
  Read cutscene
  Read songindex
  Let l.Background = bg
  Let l.CutScene = cutscene
  Let l.SongIndex = songindex
  Read lline
  Let l.Width = LEN(lline)
  Let row = 0
  While lline <> T_END And lline <> T_ENDALL
      For idx = 1 TO l.Width
        Let char = MID$(lline, idx, 1)
        If char = "*" Then
            Let l.StartPoint.col = idx - 1
            Let l.StartPoint.row = row
        Else
            Let l.Topo(idx - 1, row) = char
        End If
      Next
      Read lline
      Let row = row + 1
  Wend
  Let l.Height = row
  If lline = T_ENDALL Then
  	  Let LoadLevel% = TRUE
  Else
  	  Let LoadLevel% = FALSE
  End If
End Function

Sub LoadLevels()
    Restore LevelData
	Dim last As Integer, n As Integer
	Let last = FALSE
	Do
    	Let last = LoadLevel%(Levels(n))
    	Let n = n + 1
    Loop Until last
End Sub


' --------------------------
' Prints a level as characters onscreen
' --------------------------
Sub PrintLevel (m As LevelMap)
  Dim i, j As Integer
  For i = 1 To m.Height
    For j = 1 To m.Width
      Locate i, j
      Print m.Topo(i - 1, j - 1)
    Next
    Print
  Next
End Sub


