Sub Square_Set (s As Square, col As Integer, row As Integer)
    Let s.col = col
    Let s.row = row
End Sub

Function Square_IsValid% (s As Square)
    If s.col >= 0 _AndAlso s.col < MAP_WIDTH _AndAlso s.row >= 0 _AndAlso s.row < MAP_HEIGHT Then
        Square_IsValid% = TRUE
    Else
        Square_IsValid% = FALSE
    End If
End Function

Sub Level_GoalSquare(l As LevelMap, s As Square)
    Dim r As Integer, c As Integer
    For r = 0 To l.Height
        For c = 0 To l.Width
            If IsGoalAt(c, r, l) Then
                Let s.row = r
                Let s.col = c
                Exit Sub
            End If
        Next
    Next
End Sub

Sub Square_ToPoint (s As Square, p As Point)
    Let p.x = s.col * BLOCK_SIZE
    Let p.y = s.row * BLOCK_SIZE
End Sub

Function IsGoalAt (col As Integer, row As Integer, l As LevelMap)
    If col >= 0 _AndAlso col < MAP_WIDTH _AndAlso row >= 0 _AndAlso row < MAP_HEIGHT Then
        If l.Topo(col, row) = TILE_POLE Then
            Let IsGoalAt = TRUE
            Exit Function
        End If
    End If
    Let IsGoalAt = FALSE
End Function

Function IsEmptyAt (col As Integer, row As Integer, l As LevelMap)
    If col >= 0 _AndAlso col < MAP_WIDTH _AndAlso row >= 0 _AndAlso row < MAP_HEIGHT Then
        If l.Topo(col, row) = TILE_NOTHING Then
            Let IsEmptyAt = TRUE
            Exit Function
        End If
    End If
    Let IsEmptyAt = FALSE
End Function

Function IsBlockAt (col As Integer, row As Integer, l As LevelMap)
    If l.Topo(col, row) = TILE_BLOCK_B Or l.Topo(col, row) = TILE_BLOCK_W Or l.Topo(col, row) = TILE_SNOW Then
        Let IsBlockAt = TRUE
    Else
        Let IsBlockAt = FALSE
    End If
End Function

Function IsWhiteBlockAt (col As Integer, row As Integer, l As LevelMap)
    If l.Topo(col, row) = TILE_BLOCK_W Then
        Let IsWhiteBlockAt = TRUE
    Else
        Let IsWhiteBlockAt = FALSE
    End If
End Function

Function IsObstacleAt (col As Integer, row As Integer, l As LevelMap)
    If l.Topo(col, row) = TILE_BLOCK_B Or l.Topo(col, row) = TILE_BLOCK_W Or l.Topo(col, row) = TILE_SNOW Or l.Topo(col, row) = TILE_POLE Then
        Let IsObstacleAt = TRUE
    Else
        Let IsObstacleAt = FALSE
    End If
End Function

Function IsCookieAt (col As Integer, row As Integer, l As LevelMap)
    If l.Topo(col, row) = TILE_COOKIE Then
        Let IsCookieAt = TRUE
    Else
        Let IsCookieAt = FALSE
    End If
End Function

Function IsTuqueAt (col As Integer, row As Integer, l As LevelMap)
    If l.Topo(col, row) = TILE_TUQUE Then
        Let IsTuqueAt = TRUE
    Else
        Let IsTuqueAt = FALSE
    End If
End Function

Function IsMittenAt (col As Integer, row As Integer, l As LevelMap)
    If l.Topo(col, row) = TILE_MITTENS Then
        Let IsMittenAt = TRUE
    Else
        Let IsMittenAt = FALSE
    End If
End Function

Function IsSnowAt (col As Integer, row As Integer, l As LevelMap)
    Let IsSnowAt = FALSE

    If col < 0 Or col >= l.Width Then Exit Function
    If row < 0 Or row >= l.Height Then Exit Function

    Let IsSnowAt = (l.Topo(col, row) = TILE_SNOW)
End Function

Function IsPlayerInSnow (lp As Point, l As LevelMap)
    Let IsPlayerInSnow = FALSE
    Dim feetrow As Integer, col1 As Integer, col2 As Integer
    Let feetrow = Ceil%((lp.y + PLAYER_HEIGHT) / BLOCK_SIZE)
    Let col1 = Floor%(lp.x / BLOCK_SIZE)
    If IsSnowAt (col1, feetrow, l) Then
        Let IsPlayerInSnow = TRUE
        Exit Function
    End If
    Let col2 = Floor%((lp.x + PLAYER_WIDTH) / BLOCK_SIZE)
    If IsSnowAt (col2, feetrow, l) Then
        Let IsPlayerInSnow = TRUE
        Exit Function
    End If
End Function

Function GetSnowSlopeAt (col As Integer, row As Integer, m As LevelMap)
    Dim hasleft As Integer, hasright As Integer, hastop As Integer
	Let GetSnowSlopeAt = SLOPE_NONE
	If m.Topo(col, row) <> TILE_SNOW Then Exit Function

    Let hastop = (row > 0 _AndAlso m.Topo(col, row - 1) = TILE_SNOW) _OrElse row = 0
    Let hasleft = (col > 0 _AndAlso (m.Topo(col - 1, row) = TILE_SNOW _OrElse IsBlockAt(col - 1, row, m))) _OrElse col = 0
    Let hasright = (col < m.Width - 1 _AndAlso (m.Topo(col + 1, row) = TILE_SNOW _OrElse IsBlockAt(col + 1, row, m))) _OrElse col = m.Width - 1

    If hastop Then
        Let GetSnowSlopeAt = SLOPE_NONE
    ElseIf hasleft = hasright Then
        Let GetSnowSlopeAt = SLOPE_C
    ElseIf hasleft Then
        Let GetSnowSlopeAt = SLOPE_R
    Else
        Let GetSnowSlopeAt = SLOPE_L
    End If
End Function

Function Square_ToString$ (s As Square)
    Let Square_ToString$ = "[" + Str$(s.col) + "," + Str$(s.row) + "]"
End Function

Function IsCoffeeAt (col As Integer, row As Integer, l As LevelMap)
    If l.Topo(col, row) = TILE_COFFEE Then
        Let IsCoffeeAt = TRUE
    Else
        Let IsCoffeeAt = FALSE
    End If
End Function

' --------------------------
' Loads a level
' --------------------------
Sub LoadLevel (mapid As String, l As LevelMap)
	PrintConsole "LOADING"
    Dim lline As String, idx As Integer, char As String, row As Integer
    Dim bg As Integer, fg As Integer, cutscene As Integer, songindex As Integer
    Dim bgp_x As Integer, bgp_y As Integer, bgo_x As Integer, bgo_y As Integer
    Let l.MapId = mapid
    Read bg
    Read fg
    Read cutscene
    Read songindex
    Read bgp_x
    Read bgp_y
    Read bgo_x
    Read bgo_y
    Point_Set l.BackgroundParallax, bgp_x, bgp_y
    Point_Set l.BackgroundOffset, bgo_x, bgo_y
    Let l.Background = bg
    Let l.Foreground = fg
    Let l.CutScene = cutscene
    Let l.SongIndex = songindex
    Read lline
    Let l.Width = Len(lline)
    Let row = 0
    While lline <> TILE_END
        For idx = 1 To l.Width
            Let char = Mid$(lline, idx, 1)
            If char = "*" Then
                Let l.StartPoint.col = idx - 1
                Let l.StartPoint.row = row
            Else
                Let l.Topo(idx - 1, row) = char
            End If
        Next
        Read lline
        Let row = row + 1
    Wend
    Let l.Height = row
    PrintConsole l.MapId + " " +  str$(l.StartPoint.col) + " " + str$(l.StartPoint.row)
End Sub

Sub LoadLevels()
    Restore LevelData
    Dim n As Integer, id As String
    Let n = 0
    Do
    	Read id
    	If id = TILE_ENDALL Then Exit Do
    	PrintConsole str$(n)
        LoadLevel id, Maps(n)
        PrintConsole Maps(n).MapId
        Let n = n + 1
    Loop
    Let NumMaps = n
End Sub


' --------------------------
' Prints a level as characters onscreen
' --------------------------
Sub PrintLevel (m As LevelMap)
    Dim i, j As Integer
    For i = 1 To m.Height
        For j = 1 To m.Width
            Locate i, j
            If m.Topo(i-1,j-1) = " " Then
                Print "x"
            Else
                Print m.Topo(i - 1, j - 1)
            End If
        Next
        Print
    Next
End Sub

Sub LoadSections
    Dim entry As String, levelId As String
    Dim s As Integer, l As Integer, m As Integer
    Dim pendingCutscene As Integer

    Let s = -1
    Let l = -1
    Let pendingCutscene = -1

    Restore Sections

    Do
        Read entry

        Select Case entry

            Case "SECTION"
                Let s = s + 1
                Read GameSections(s).Name
                Read GameSections(s).Music
                Let GameSections(s).FirstLevel = l + 1
                Let GameSections(s).LastLevel = l
                Let GameSections(s).Cutscene = -1
                Let GameSections(s).Backgrounds(0) = -1
                Let GameSections(s).Backgrounds(1) = -1
                Let pendingCutscene = -1

            Case "CUTSCENE"
                Read pendingCutscene

                ' Remember the section's introductory cutscene
                If GameSections(s).FirstLevel = l + 1 Then
                    Let GameSections(s).Cutscene = pendingCutscene
                End If
                
            Case "BACKGROUNDS"
            	Read GameSections(s).Backgrounds(0)
            	Read GameSections(s).Backgrounds(1)

            Case "LEVEL"
    Read levelId
    Let m = FindMap%(levelId)

    If m < 0 Then
        Print "Unknown level: "; levelId
        End
    End If

    Let l = l + 1
    Let Levels(l) = Maps(m)
    Let Levels(l).Section = s

    ' Inherit music if unspecified
    If Levels(l).SongIndex = -1 Then
        Let Levels(l).SongIndex = GameSections(s).Music
    End If

    ' Inherit alternating background if unspecified
    If Levels(l).Background = -1 Then
        Let Levels(l).Background = GameSections(s).Backgrounds( _
            (l - GameSections(s).FirstLevel) Mod 2)
    End If

    Let Levels(l).Cutscene = pendingCutscene
    Let GameSections(s).LastLevel = l
    Let pendingCutscene = -1

            Case "END"
                Exit Do

            Case Else
                Print "Unknown section entry: "; entry
                End

        End Select
    Loop

    Let NumLevels = l + 1
    Let NumSections = s + 1
    For l = 0 To NumLevels - 1
    PrintConsole Levels(l).MapId + _
        " BG=" + Str$(Levels(l).Background) + _
        " Song=" + Str$(Levels(l).SongIndex)
Next
End Sub

Function FindMap% (levelId As String)
    Dim i As Integer
    For i = 0 To NumMaps - 1
        If Maps(i).MapId = levelId Then
            Let FindMap% = i
            Exit Function
        End If
    Next

    Let FindMap% = -1
End Function


