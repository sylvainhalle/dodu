Sub LoadPasswords()
    Restore PWS
    Dim i As Integer, j As Integer, k As Integer, n As Integer
    For i = 0 To 19
        For j = 0 To 3
            For k = 0 To 3
                Read n
                Let PASSWORDS(i, j).Elements(k) = n
            Next
        Next
    Next
End Sub

Sub GetPassword (p As Password, level As Integer, hasmittens As Integer, hastuque As Integer)
	Dim idx As Integer, i As Integer
	If hasmittens Then
		Let idx = idx + 1
	End If
	If hastuque Then
		Let idx = idx + 2
	End If
	For i = 0 To 3
		Let p.Elements(i) = PASSWORDS(level, idx).Elements(i)
	Next
End Sub

Sub LookupPassword (rp As RestorePoint, selection() As Integer)
	Dim level As Integer, tuque As Integer, mittens As Integer, column as Integer, i As Integer
	Let rp.Level = -1
	Let rp.HasMittens = 0
	Let rp.HasTuque = 0
	For level = 0 to 20
		for mittens = 0 to 1
			for tuque = 0 to 1
				let column = mittens + (tuque * 2)
				Dim found As Integer
				Let found = TRUE
				For i = 0 to 3
					Dim j As Integer, contains As Integer
					Let contains = FALSE
					For j = 0 To 3
						If PASSWORDS(level, column).Elements(j) = selection(i) Then
							Let contains = TRUE
							print "OK" + str$(i)
							Exit For
						End If
					Next
					If Not contains Then
						print "NO" + str$(i)
						Let found = FALSE
						Exit For
					End If
				Next
				If found Then
					Let rp.Level = level
					Let rp.HasMittens = (mittens = 1)
					Let rp.HasTuque = (tuque = 1)
					Exit Sub
				End If
			next
		next
	Next
End Sub

