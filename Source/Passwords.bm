Sub LoadPasswords()
	Restore PWS
	Dim i As Integer, j As Integer, k As Integer, n As Integer
	For i = 0 To 19
		For j = 0 To 3
			Dim p As Password
			For k = 0 To 3
				Read n
				Let p.Elements(k) = n
			Next
			Let PASSWORDS(i, j) = p
		Next
	Next
End Sub

Sub GetPassword (p As Password, level As Integer, hasmittens As Integer, hastuque As Integer)
	Dim idx As Integer, i As Integer
	If hasmittens Then
		Let idx = idx + 1
	End If
	If hastuque Then
		Let idx = idx + 2
	End If
	For i = 0 To 3
		Let p.Elements(i) = PASSWORDS(level, idx).Elements(i)
	Next
End Sub

