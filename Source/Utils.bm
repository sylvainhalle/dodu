Function Ceil% (x As Single)
  Dim z As Integer
  Let z = CInt(x)
  If z < x Then z = z + 1
  Let Ceil% = z
End Function

Function Floor% (x As Single)
  Dim z As Integer
  Let z = CInt(x)
  If z > x Then z = z - 1
  Let Floor% = z
End Function

Function NbFormat$ (x As Integer)
	if x < 10 Then
		let NbFormat$ = " " + _Trim$(Str$(x))
	else
		let NbFormat$ = _Trim$(Str$(x))
	end if
End Function

