Sub DrawLevelNumber (v As Viewport)
  Dim dg1 As Integer, dg2 As Integer
  Let dg1 = (CURRENT_LEVEL + 1) \ 10
  Let dg2 = (CURRENT_LEVEL + 1) Mod 10
  Dim p2 As Point
  If dg1 = 0 Then
    Point_Set p2, PT_LEVEL_NB.x + 3, PT_LEVEL_NB.y
    Viewport_PutSpriteSequence v, TRUE, SPR_LVL_DIGITS(dg2), p2, FALSE
  Else
    Point_Set p2, PT_LEVEL_NB.x + 5, PT_LEVEL_NB.y
    Viewport_PutSpriteSequence v, TRUE, SPR_LVL_DIGITS(dg1), PT_LEVEL_NB, FALSE
    Viewport_PutSpriteSequence v, TRUE, SPR_LVL_DIGITS(dg2), p2, FALSE
  End If
End Sub

Sub DrawNumber (v As Viewport, p As Point, n As Integer)
  Dim dg1 As Integer, dg2 As Integer
  Let dg1 = n \ 10
  Let dg2 = n Mod 10
  Dim p2 As Point
  Point_Set p2, p.x + 6, p.y
  'If dg1 <> 0 Then
    Viewport_PutSpriteSequence v, TRUE, SPR_LVL_DIGITS(dg1), p, FALSE
  'end if
  Viewport_PutSpriteSequence v, TRUE, SPR_LVL_DIGITS(dg2), p2, FALSE
End Sub

' :mode=visualbasic: