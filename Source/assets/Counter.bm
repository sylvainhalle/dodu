Sub DrawLevelNumber (v As Viewport, layer As Integer)
    Dim dg1 As Integer, dg2 As Integer
    Let dg1 = (CurrentLevel + 1) \ 10
    Let dg2 = (CurrentLevel + 1) Mod 10
    Dim p2 As Point
    If dg1 = 0 Then
        Point_Set p2, PtLevelNb.x + 3, PtLevelNb.y
        Viewport_PutSpriteSequence v, TRUE, SprLvlDigits(dg2), p2, FALSE, layer
    Else
        Point_Set p2, PtLevelNb.x + 5, PtLevelNb.y
        Viewport_PutSpriteSequence v, TRUE, SprLvlDigits(dg1), PtLevelNb, FALSE, layer
        Viewport_PutSpriteSequence v, TRUE, SprLvlDigits(dg2), p2, FALSE, layer
    End If
End Sub

Sub DrawNumber (v As Viewport, p As Point, n As Integer, layer As Integer)
    Dim dg1 As Integer, dg2 As Integer
    Let dg1 = n \ 10
    Let dg2 = n Mod 10
    Dim p2 As Point
    Point_Set p2, p.x + 6, p.y
    'If dg1 <> 0 Then
    Viewport_PutSpriteSequence v, TRUE, SprLvlDigits(dg1), p, FALSE, layer
    'end if
    Viewport_PutSpriteSequence v, TRUE, SprLvlDigits(dg2), p2, FALSE, layer
End Sub

' :mode=visualbasic: