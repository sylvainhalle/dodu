' --------------------------
' Sprite functions
' --------------------------

On Error Goto ErrHandler
Dim Shared ERRFILE As String

' DependsOn: Ticker

'**
'** - Point ------------------------------------------------- {{{
'**

Sub Point_Set (p As Point, x As Integer, y As Integer)
  Let p.x = x
  Let p.y = y
End Sub

Function Point_ToString$ (p As Point)
  Let Point_ToString$ = "(" + _Trim$(Str$(p.x)) + "," + _Trim$(Str$(p.y)) + ")"
End Function

Sub Point_Scale (p As Point, s as Single)
	Point_Set p, p.x * s, p.y * s
End Sub

Sub Point_Add (p1 As Point, vector As Point)
	Let p1.x = p1.x + vector.x
	Let p1.y = p1.y + vector.y
End Sub

Sub Point_Subtract (p1 As Point, vector As Point)
	Let p1.x = p1.x - vector.x
	Let p1.y = p1.y - vector.y
End Sub

' }}}

'**
'** - Sprite sequence------------------------------------------- {{{
'**

Function SpriteSequence_Width% (s As SpriteSequence)
	if s.Content <> -1 then
		Let SpriteSequence_Width% = s.Size.x \ s.Ticker.Length
	else
		Let SpriteSequence_Width% = -1
	end if
End Function

Function SpriteSequence_Height% (s As SpriteSequence)
	Let SpriteSequence_Height% = s.Size.y
End Function

Sub SpriteSequence_Copy (target As SpriteSequence, source As SpriteSequence)
	Let target.Ticker = source.Ticker
	Let target.Content = source.Content
	Let target.Flipped = source.Flipped
	Let target.OffsetL = source.OffsetL
	Let target.OffsetR = source.OffsetR
	Let target.Size = source.Size
	Let target.Animate = source.Animate
End Sub

Sub SpriteSequence_InitFile (s As SpriteSequence, filename As String, frames As Integer, spd As Integer, animate As Integer, isloop As Integer, offsetL As Point, offsetR As Point, clr As _Unsigned Long)
	Dim e As Long
	Let e = _LoadImage(filename, SPRITE_MODE%)
	If e = -1 Then
		Let ERRFILE = filename
		Error 97 ' 97 is the user-defined code
	End If
	SpriteSequence_Init s, e, frames, spd, animate, isloop, offsetL, offsetR, clr
End Sub


Sub SpriteSequence_Init (s As SpriteSequence, content As Long, frames As Integer, spd As Integer, animate As Integer, isloop As Integer, offsetL As Point, offsetR As Point, clr As _Unsigned Long)
	If content = -1 Then
		Let ERRFILE = "FOO"
		Error 97
	End If
	_ClearColor clr, content
	Ticker_Init s.Ticker, frames, spd, isloop
	Let s.Animate = animate
	Let s.Content = content
	Let s.Size.x = _Width(content)
	Let s.Size.y = _Height(content)
	Let s.OffsetL = offsetL
	Let s.OffsetR = offsetR
	Let s.Flipped = FALSE
End Sub

Sub SpriteSequence_Tick (s As SpriteSequence)
	If s.Animate Then
		Ticker_Tick s.Ticker
	End If
End Sub

Sub SpriteSequence_Stop (s As SpriteSequence)
	Ticker_Stop s.Ticker
End Sub

Sub SpriteSequence_Start (s As SpriteSequence)
	If Not Ticker_IsRunning(s.Ticker) Then
		Ticker_Reset s.Ticker
	End If
End Sub

Sub SpriteSequence_Current (s as SpriteSequence, p1 As Point, p2 As Point)
	Dim ind As Integer
	Let ind = _Max(0, s.Ticker.Index)
	Point_Set p1, ind * (s.Size.x \ s.Ticker.Length), 0
	Point_Set p2, (ind + 1) * (s.Size.x \ s.Ticker.Length) - 1, s.Size.y - 1
End Sub


'**
'** - Trajectory------------------------------------------------ {{{
'**

Sub Trajectory_Init (t As Trajectory, l As Integer, speed As Integer, flipped As Integer, isloop As Integer)
	Ticker_Init t.Ticker, l, speed, isloop
	let t.Flipped = flipped
End Sub

Sub Trajectory_AddPoint (t as Trajectory, p As Point, index As Integer)
	let t.Points(index).x = p.x
	let t.Points(index).y = p.y
End Sub

Sub Trajectory_Copy (dst As Trajectory, src As Trajectory)
	Dim i As Integer
	Ticker_Copy dst.Ticker, src.Ticker
	Let dst.Flipped = src.Flipped
	For i = 0 To 9
		Let dst.Points(i).x = src.Points(i).x
		Let dst.Points(i).y = src.Points(i).y
	Next
End Sub

Sub Trajectory_AddCoords (t As Trajectory, x as Integer, y as Integer, index As Integer)
	dim p As Point
	Point_Set p, x, y
	Trajectory_AddPoint t, p, index
End Sub

Sub Trajectory_Tick (t As Trajectory, p as Point)
	Point_Set p, 0, 0
	If t.Ticker.Index >= 0 And t.Ticker.TickCnt = 0 Then
		If t.Flipped Then
			Point_Set p, -t.Points(t.Ticker.Index).x, t.Points(t.Ticker.Index).y
		Else
			Point_Set p, t.Points(t.Ticker.Index).x, t.Points(t.Ticker.Index).y
		End If
	End If
	Ticker_Tick t.Ticker
End Sub

Sub Trajectory_Reset (t As Trajectory)
	Ticker_reset t.Ticker
End Sub

'**
'** - Viewport ------------------------------------------------- {{{
'**

Sub Viewport_Init_Default (v As Viewport, size As Point, ws As Point)
  Viewport_Init v, size, ws, P_ORIGIN, 1
End Sub

Sub Viewport_Init (v As Viewport, size As Point, ws As Point, pan As Point, scale As Single)
  Let v.Size = size
  Let v.WorldSize = ws
  Let v.Pan = pan
  Let v.Scale = scale
  Let v.Buffer = _NewImage(size.x * scale, size.y * scale, SPRITE_MODE%)
  Let v.BackgroundPanRatio.x = -1
  Let v.BackgroundPanRatio.y = -1
  Let v.ForegroundPanRatio.x = -1
  Let v.ForegroundPanRatio.y = -1
  Let v.Scanlines = FALSE
  Ticker_Stop v.FadeInTicker
  Ticker_Stop v.FadeOutTicker
End Sub

Sub Viewport_PointToScreen (v As Viewport, p_src As Point, p_dest As Point)
  Let p_dest.x = p_src.x - v.Pan.x
  Let p_dest.y = p_src.y - v.Pan.y
End Sub

Sub Viewport_Clear (v As Viewport)
  Dim sq As Point
  Point_Set sq, v.Size.x * v.Scale - 1, v.Size.y * v.Scale - 1
  Viewport_Line v, TRUE, P_ORIGIN, sq, COLOR_BLACK, TRUE, TRUE
  Dim screen_offset As Point, bg_offset As Point
  If v.BackgroundPanRatio.x > 0 Then
	  Point_Set screen_offset, v.Pan.x Mod v.Size.x, v.Pan.y Mod v.Size.y
	  Point_Set bg_offset, CInt(screen_offset.x / v.BackgroundPanRatio.x), CInt(screen_offset.y / v.BackgroundPanRatio.y)
  ElseIf v.BackgroundPanRatio.x = 0 Then
  	  Point_Set screen_offset, 0, 0
  	  Point_Set bg_offset, 0, 0
  Else
  	Exit Sub
  End If
  Dim x As Integer, y As Integer
  For x = bg_offset.x - v.Size.x To v.Size.x + SpriteSequence_Width%(v.Background) Step SpriteSequence_Width%(v.Background)
	  For y = bg_offset.y - v.Size.y To v.Size.y Step v.Background.Size.y
		Dim p As Point
		Point_Set p, x, y
		Viewport_PutSpriteSequence v, TRUE, v.Background, p, FALSE
	  Next
  Next
End Sub

Sub Viewport_SetBackground (v As Viewport, s As SpriteSequence, ratio As Point)
	Let v.Background = s
	Let v.BackgroundPanRatio.x = ratio.x
	Let v.BackgroundPanRatio.y = ratio.y
End Sub

Sub Viewport_SetForeground (v As Viewport, s As SpriteSequence, ratio As Point)
	Let v.Foreground = s
	Let v.ForegroundPanRatio.x = ratio.x
	Let v.ForegroundPanRatio.y = ratio.y
End Sub

Sub Viewport_LineC (v As Viewport, absolute As Integer, x1 As Integer, y1 As Integer, x2 As Integer, y2 As Integer, clr As Long, box As Integer, filled As Integer)
  _Dest v.Buffer
  Dim p1 As Point, p2 As Point
  Point_Set p1, x1, y1
  Point_Set p2, x2, y2
  If Not absolute Then
  	  Point_Subtract p1, v.Pan
  	  Point_Subtract p2, v.Pan
  End If
  Point_Scale p1, v.Scale
  Point_Scale p2, v.Scale
  If box And filled Then
	Line (p1.x, p1.y) - (p2.x, p2.y), clr, BF
  ElseIf box Then
	Line (p1.x, p1.y) - (p2.x, p2.y), clr, B
  Else
	Line (p1.x, p1.y) - (p2.x, p2.y), clr
  End If
End Sub

Sub Viewport_Line (v As Viewport, absolute As Integer, p1 As Point, p2 As Point, clr As Long, box As Integer, filled As Integer)
  Viewport_LineC v, absolute, p1.x, p1.y, p2.x, p2.y, clr, box, filled
End Sub

Sub Viewport_Screen (v as Viewport)
	Screen v.Buffer
End Sub

Sub Viewport_Copy (src As Viewport, dst As Viewport)
  _PutImage , src.Buffer, dst.Buffer
End Sub

Sub Viewport_Print (v As Viewport, s As String, p As Point)
  _PrintString (p.x, p.y), s, v.Buffer
End Sub

Sub Viewport_SetFont (v as Viewport, font As _Unsigned Long)
	_Font font, v.Buffer
End Sub

Sub Viewport_Display (v As Viewport)
	_Dest v.Buffer
	If Ticker_IsRunning%(v.FadeInTicker) Then
		Line (0, 0)-(v.Size.x * v.Scale, v.Size.y * v.Scale), _RGB32(0, 0, 0, CInt(255 - (255 * v.FadeInTicker.Index / v.FadeInTicker.Length))), BF
	End If
	If Ticker_IsRunning%(v.FadeOutTicker) Then
		Line (0, 0)-(v.Size.x * v.Scale, v.Size.y * v.Scale), _RGB32(0, 0, 0, CInt(255 * v.FadeInTicker.Index / v.FadeOutTicker.Length)), BF
	End If
	If v.Scanlines Then
		Dim y As Integer
		For y = 0 To v.Size.y * v.Scale Step v.Scale
			Line (0, y)-(v.Size.x * v.Scale, y), _RGB32(0, 0, 0, 56)
		Next
	End If
	_Display
End Sub

Sub Viewport_Wait (src As Viewport, dst As Viewport, dur As Single, fps As Integer)
	Dim ticks As Integer
	Let ticks = Ceil%(dur * fps)
	While ticks > 0
		_Limit fps
		Let ticks = ticks - 1
		Viewport_Tick src
		Viewport_Copy src, dst
		Viewport_Tick dst
		Viewport_Display dst
	Wend
End Sub

Sub Viewport_PutSpriteSequence (v As Viewport, absolute As Integer, s As SpriteSequence, p As Point, flipped As Integer)
	Dim p1 As Point, p2 As Point
	Dim s_w As Integer, s_h As Integer
	if s.Ticker.Length <= 0 then
		cls
		print "FOO"
		'end
	end if
	Let s_w = SpriteSequence_Width%(s)
	Let s_h = SpriteSequence_Height%(s)
	SpriteSequence_Current s, p1, p2
	If absolute Then
    If flipped Then
      _PutImage (p.x + s.OffsetR.x + s_w - 1, p.y + s.OffsetR.y)-(p.x + s.OffsetR.x, p.y + s.OffsetR.y + s_h - 1), s.Content, v.Buffer, (p1.x, p1.y)-(p2.x, p2.y)
    Else
      _PutImage (p.x + s.OffsetL.x, p.y + s.OffsetL.y)-(p.x + s.OffsetL.x + s_w - 1, p.y + s.OffsetL.y + s_h - 1), s.Content, v.Buffer, (p1.x, p1.y)-(p2.x, p2.y)
    End If
  Else
    If flipped Then
      _PutImage (p.x + s.OffsetR.x + s_w - 1 - v.Pan.x, p.y + s.OffsetR.y - v.Pan.y)-(p.x + s.OffsetR.x - v.Pan.x, p.y + s.OffsetR.y + s_h - 1 - v.Pan.y), s.Content, v.Buffer, (p1.x, p1.y)-(p2.x, p2.y)
    Else
      _PutImage (p.x + s.OffsetL.x - v.Pan.x, p.y + s.OffsetL.y - v.Pan.y)-(p.x + s.OffsetL.x + s_w - 1 - v.Pan.x, p.y + s.OffsetL.y + s_h - 1 - v.Pan.y), s.Content, v.Buffer, (p1.x, p1.y)-(p2.x, p2.y)
    End If
  End If
End Sub

Sub Viewport_SetCenter (v as Viewport, p as Point)
	let v.Pan.x = Clamp%(p.x - v.Size.x \ 2, 0, v.WorldSize.x - v.Size.x)
	let v.Pan.y = Clamp%(p.y - v.Size.y \ 2, 0, v.WorldSize.y - v.Size.y)
End Sub

Sub Viewport_MovePan (v as Viewport, p as Point)
	Let v.Pan.x = Clamp%(v.Pan.x + p.x, 0, _Max(v.Size.x, v.WorldSize.x - v.Size.x))
	Let v.Pan.y = Clamp%(v.Pan.y + p.y, 0, _Max(v.Size.y, v.WorldSize.y - v.Size.y))
End Sub

Sub Viewport_ScrollPan (v as Viewport, target as Point, nbframes As Integer)
	Ticker_Init v.PanTick, nbframes, 1, FALSE
	Point_Set v.PanTarget, target.x, target.y
	Point_Set v.PanAmount, (target.x - v.Pan.x) \ nbframes, (target.y - v.Pan.y) \ nbframes
End Sub

Sub Viewport_ScrollCenter (v As Viewport, p As Point, nbframes As Integer)
	Dim target As Point
	let target.x = Clamp%(p.x - v.Size.x \ 2, 0, v.WorldSize.x - v.Size.x)
	let target.y = Clamp%(p.y - v.Size.y \ 2, 0, v.WorldSize.y - v.Size.y)
	Viewport_ScrollPan v, target, nbframes
End Sub

Sub Viewport_StopPan (v as Viewport)
	Ticker_Stop v.PanTick
End Sub

Sub Viewport_Tick (v as Viewport)
	If Ticker_IsRunning%(v.PanTick) Then
		Dim panamt As Point
		Point_Set panamt, _Round((v.PanTarget.x - v.Pan.x) / (v.PanTick.Length - v.PanTick.Index)), _Round((v.PanTarget.y - v.Pan.y) / (v.PanTick.Length - v.PanTick.Index))
		Viewport_MovePan v, panamt
		Ticker_Tick v.PanTick
		If Ticker_IsFinished%(v.PanTick) Then
			Point_Set v.PanTarget, -1, -1
			Point_Set v.PanAmount, 0, 0
		End If
	End If
	SpriteSequence_Tick v.Background
	SpriteSequence_Tick v.Foreground
	Ticker_Tick v.FadeInTicker
	Ticker_Tick v.FadeOutTicker
End Sub

Sub Viewport_SetAlpha (v As Viewport, alpha As Integer)
	_Dest v.Buffer
	_SetAlpha alpha
End Sub

Sub Viewport_FadeIn (v As Viewport, numticks As Integer)
	Ticker_Stop v.FadeOutTicker
	Ticker_Init v.FadeInTicker, numticks, 1, FALSE
End Sub

Sub Viewport_FadeOut (v As Viewport, numticks As Integer)
	Ticker_Stop v.FadeInTicker
	Ticker_Init v.FadeOutTicker, numticks, 1, FALSE
End Sub
' }}}

ErrHandler:
print ERRFILE
End


