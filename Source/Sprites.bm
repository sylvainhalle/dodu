' --------------------------
' Sprite functions
' --------------------------


'**
'** - Point ------------------------------------------------- {{{
'**

Sub Point_Set (p As Point, x As Integer, y As Integer)
  Let p.x = x
  Let p.y = y
End Sub

Function Point_ToString$ (p As Point)
  Let Point_ToString$ = "(" + _Trim$(Str$(p.x)) + "," + _Trim$(Str$(p.y)) + ")"
End Function

Function Point_Scale (p2 As Point, s as Single, p1 As Point)
	let p2.x = p1.x * s
	let p2.y = p1.y * s
End Function

' }}}

'**
'** - Sprite ------------------------------------------------- {{{
'**

Sub Sprite_Load (s As Sprite, file As String, offset As Point, offsetflip As Point, clr As Long)
  Let s.Content = _LoadImage(file, 32)
  Point_Set s.Size, _Width(s.Content), _Height(s.Content)
  Let s.Offset = offset
  Let s.OffsetFlip = offsetflip
  '_ClearColor clr, s.Content
  _SetAlpha 0, clr, s.Content
End Sub

Sub Sprite_Copy (dst As Sprite, src As Sprite)
	Let dst.Content = src.Content
	Let dst.Size.x = src.Size.x
	Let dst.Size.y = src.Size.y
	Let dst.Offset.x = src.Offset.x
	Let dst.Offset.y = src.Offset.y
	Let dst.OffsetFlip.x = src.OffsetFlip.x
	Let dst.OffsetFlip.y = src.OffsetFlip.y
End Sub

' }}}

'**
'** - Ticker    ------------------------------------------------ {{{
'**

Sub Ticker_Init (t As Ticker, l As Integer, speed As Integer, isloop As Integer)
	let t.Length = l
	let t.Speed = speed
	let t.Loop = isloop
	let t.TickCnt = 0
	let t.Index = 0
End Sub

Sub Ticker_Tick (t As Ticker)
	If t.Index >= 0 Then
		Let t.TickCnt = (t.TickCnt + 1) Mod t.Speed
		If t.TickCnt = 0 Then
			Let t.Index = t.Index + 1
			If t.Index = t.Length Then
				If t.Loop Then
					let t.Index = 0
				Else
					let t.Index = -1
				End If
			End If
		End If
	End If
End Sub

Sub Ticker_Reset (t As Ticker)
	let t.TickCnt = 0
	let t.Index = 0
End Sub

Function Ticker_Finished% (t as Ticker)
	if t.Index < 0 Then
		let Ticker_Finished% = TRUE
	else
		let Ticker_Finished% = FALSE
	end if
End Sub

'**
'** - Sprite sequence------------------------------------------- {{{
'**

Sub SpriteSequence_Init (s As SpriteSequence, l As Integer, spd As Integer, isloop As Integer)
	Ticker_Init s.Ticker, l, spd, isloop
	let s.Flipped = FALSE
End Sub

Sub SpriteSequence_Tick (s As SpriteSequence)
	Ticker_Tick s.Ticker
End Sub

Sub SpriteSequence_Current (s as SpriteSequence, spr as Sprite)
	If s.Ticker.Index >= 0 Then
		Sprite_Copy spr, s.Sprites(s.Ticker.Index)
	End If
End Sub

Sub SpriteSequence_Load (s As SpriteSequence, spr As Sprite, index As Integer)
	Sprite_Copy s.Sprites(index), spr
End Sub

Sub SpriteSequence_BulkLoad (s as SpriteSequence, pattern AS String, length As Integer, speed As Integer, isloop As Integer, offset As Point, offsetFlip As Point, clr As Long)
	SpriteSequence_Init s, length, speed, isloop
	Dim x as Integer, sprl As Sprite
	For x = 0 To length - 1
		Sprite_Load sprl, pattern + _Tostr$(x) + ".gif", offset, offsetflip, clr
	SpriteSequence_Load s, sprl, x
	Next
End Sub

'**
'** - Trajectory------------------------------------------------ {{{
'**

Sub Trajectory_Init (t As Trajectory, l As Integer, speed As Integer, flipped As Integer, isloop As Integer)
	Ticker_Init t.Ticker, l, speed, isloop
	let t.Flipped = flipped
End Sub

Sub Trajectory_AddPoint (t as Trajectory, p As Point, index As Integer)
	let t.Points(index).x = p.x
	let t.Points(index).y = p.y
End Sub

Sub Trajectory_AddCoords (t As Trajectory, x as Integer, y as Integer, index As Integer)
	dim p As Point
	Point_Set p, x, y
	Trajectory_AddPoint t, p, index
End Sub

Sub Trajectory_Tick (t As Trajectory, p as Point)
	Point_Set p, 0, 0
	If t.Ticker.Index >= 0 And t.Ticker.TickCnt = 0 Then
		If t.Flipped Then
			Point_Set p, -t.Points(t.Ticker.Index).x, t.Points(t.Ticker.Index).y
		Else
			Point_Set p, t.Points(t.Ticker.Index).x, t.Points(t.Ticker.Index).y
		End If
	End If
	Ticker_Tick t.Ticker
End Sub

Sub Trajectory_Reset (t As Trajectory)
	Ticker_reset t.Ticker
End Sub

'**
'** - Viewport ------------------------------------------------- {{{
'**

Sub Viewport_Init_Default (v As Viewport, size As Point)
  Viewport_Init v, size, P_ORIGIN, 1
End Sub

Sub Viewport_Init (v As Viewport, size As Point, pan As Point, scale As Single)
  Let v.Size = size
  Let v.Pan = pan
  Let v.Scale = scale
  Let v.Buffer = _NewImage(size.x * scale, size.y * scale, 32)
  Let v.BackgroundPanRatio.x = -1
  Let v.BackgroundPanRatio.y = -1
End Sub


Sub Viewport_PointToScreen (v As Viewport, p_src As Point, p_dest As Point)
  Let p_dest.x = p_src.x - v.Pan.x
  Let p_dest.y = p_src.y - v.Pan.y
End Sub

Sub Viewport_Clear (v As Viewport)
  Dim sq As Point
  Point_Set sq, v.Size.x * v.Scale - 1, v.Size.y * v.Scale - 1
  Viewport_Line v, P_ORIGIN, sq, COLOR_BLACK, TRUE, TRUE
  If v.BackgroundPanRatio.x >= 0 Then ' No background, put black
	  Dim screen_offset As Point, bg_offset As Point
	  Point_Set screen_offset, v.Pan.x Mod v.Size.x, v.Pan.y Mod v.Size.y
	  Point_Set bg_offset, CInt(screen_offset.x / v.BackgroundPanRatio.x), CInt(screen_offset.y / v.BackgroundPanRatio.y)
	  Dim x As Integer, y As Integer
	  For x = bg_offset.x - v.Size.x To v.Size.x Step v.Background.Size.x
		  For y = bg_offset.y - v.Size.y To v.Size.y Step v.Background.Size.y
			Dim p As Point
			Point_Set p, x, y
			Viewport_PutSprite v, TRUE, v.Background, p, FALSE
		  Next
	  Next
  End If
End Sub

Sub Viewport_SetBackground (v As Viewport, s As Sprite, ratio As Point)
	Sprite_Copy v.Background, s
	Let v.BackgroundPanRatio.x = ratio.x
	Let v.BackgroundPanRatio.y = ratio.y
End Sub

Sub Viewport_Line (v As Viewport, p1 As Point, p2 As Point, clr As Long, box As Integer, filled As Integer)
  _Dest v.Buffer
  If box And filled Then
    Line ((p1.x - v.Pan.x) * v.Scale, (p1.y - v.Pan.y) * v.Scale)-((p2.x - v.Pan.x) * v.Scale, (p2.y - v.Pan.y) * v.Scale), clr, BF
  ElseIf box Then
    Line ((p1.x - v.Pan.x) * v.Scale, (p1.y - v.Pan.y) * v.Scale)-((p2.x - v.Pan.x) * v.Scale, (p2.y - v.Pan.y) * v.Scale), clr, B
  Else
    Line ((p1.x - v.Pan.x) * v.Scale, (p1.y - v.Pan.y) * v.Scale)-((p2.x - v.Pan.x) * v.Scale, (p2.y - v.Pan.y) * v.Scale), clr
  End If
End Sub

Sub Viewport_Screen (v as Viewport)
	Screen v.Buffer
End Sub

Sub Viewport_Copy (src As Viewport, dst As Viewport)
  _PutImage , src.Buffer, dst.Buffer
End Sub

Sub Viewport_Print (v As Viewport, s As String, p As Point)
  _PrintString (p.x, p.y), s, v.Buffer
End Sub

Sub Viewport_SetFont (v as Viewport, font As _Unsigned Long)
	_Font font, v.Buffer
End Sub

Sub Viewport_PutSprite (v As Viewport, absolute As Integer, s As Sprite, p As Point, flipped As Integer)
  If absolute = TRUE Then
    If flipped = TRUE Then
      _PutImage (p.x + s.OffsetFlip.x + s.Size.x - 1, p.y + s.OffsetFlip.y)-(p.x + s.OffsetFlip.x, p.y + s.OffsetFlip.y + s.Size.y - 1), s.Content, v.Buffer
    Else
      _PutImage (p.x + s.Offset.x, p.y + s.Offset.y)-(p.x + s.Offset.x + s.Size.x - 1, p.y + s.Offset.y + s.Size.y - 1), s.Content, v.Buffer
    End If
  Else
    If flipped Then
      _PutImage (p.x + s.OffsetFlip.x + s.Size.x - 1 - v.Pan.x, p.y + s.OffsetFlip.y - v.Pan.y)-(p.x + s.OffsetFlip.x - v.Pan.x, p.y + s.OffsetFlip.y + s.Size.y - 1 - v.Pan.y), s.Content, v.Buffer
    Else
      _PutImage (p.x + s.Offset.x - v.Pan.x, p.y + s.Offset.y - v.Pan.y)-(p.x + s.Offset.x + s.Size.x - 1 - v.Pan.x, p.y + s.Offset.y + s.Size.y - 1 - v.Pan.y), s.Content, v.Buffer
    End If
  End If
End Sub

Sub Viewport_PutSpriteSequence (v As Viewport, absolute As Integer, s As SpriteSequence, p As Point)
	Dim spr As Sprite
	SpriteSequence_Current s, spr
	Viewport_PutSprite v, absolute, spr, p, s.Flipped
End Sub

Sub Viewport_SetCenter (v as Viewport, p as Point)
	let v.Pan.x = p.x - v.Size.x \ 2
	let v.Pan.y = p.y - v.Size.y \ 2
End Sub
' }}}


