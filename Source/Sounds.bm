Sub SoundPlayer_Init (sp As SoundPlayer)
	let sp.PlaySong = TRUE
	let sp.PlayEffects = TRUE
	let sp.CurrentSong = 0
End Sub

Sub SoundPlayer_AddSong (sp As SoundPlayer, index As Integer, ptr As _Unsigned Long, vol As Single)
	let sp.Songs(index) = ptr
	_SndVol ptr, vol
End Sub

Sub SoundPlayer_AddEffect (sp As SoundPlayer, index As Integer, ptr As _Unsigned Long, vol As Single)
	let sp.Effects(index) = ptr
	_SndVol ptr, vol
End Sub

Sub SoundPlayer_SetPlayEffects (sp As SoundPlayer, pl As Integer)
	let sp.PlayEffects = pl
End Sub

Sub SoundPlayer_SetPlaySong (sp As SoundPlayer, pl As Integer)
	let sp.PlaySong = pl
	If pl = FALSE Then
		SoundPlayer_StopSong sp
	End If
End Sub

Sub SoundPlayer_PlaySong (sp As SoundPlayer, index As Integer)
	If sp.PlaySong = TRUE Then
		Let sp.CurrentSong = sp.Songs(index)
		_SndLoop sp.CurrentSong
	End If
End Sub

Sub SoundPlayer_StopSong (sp As SoundPlayer)
	If sp.PlaySong = TRUE And sp.CurrentSong >= 0 Then
		_SndStop sp.CurrentSong
		Let sp.CurrentSong = 0
	End If
End Sub

Sub SoundPlayer_SetSongVolume (sp As SoundPlayer, v As Single)
	If sp.PlaySong = TRUE And sp.CurrentSong >= 0 Then
		_SndVol sp.CurrentSong, v
	End If
End Sub

Sub SoundPlayer_PlayEffect (sp As SoundPlayer, index As Integer)
	If sp.PlayEffects = TRUE Then
		_SndPlay sp.Effects(index)
	End If
End Sub

Sub SoundPlayer_PauseSong (sp As SoundPlayer)
	If sp.PlaySong = TRUE And sp.CurrentSong >= 0 Then
		_SndPause sp.CurrentSong
	End If
End Sub

Sub SoundPlayer_ResumeSong (sp As SoundPlayer)
	If sp.PlaySong = TRUE And sp.CurrentSong >= 0 Then
		_SndPlay sp.CurrentSong
	End If
End Sub

Function SoundPlayer_IsPlayingSong% (sp As SoundPlayer)
	Let SoundPlayer_IsPlayingSong% = (sp.CurrentSong <> 0 _AndAlso Not _SndPaused(sp.CurrentSong))
End Function


' :mode=visualbasic:folding=explicit:wrap=none: