Sub Ticker_Init (t As Ticker, l As Integer, speed As Integer, isloop As Integer)
	let t.Length = l
	let t.Speed = speed
	let t.Loop = isloop
	let t.TickCnt = 0
	let t.Index = 0
End Sub

Sub Ticker_Tick (t As Ticker)
	If t.Index >= 0 and t.Speed > 0 Then
		Let t.TickCnt = (t.TickCnt + 1) Mod t.Speed
		If t.TickCnt = 0 Then
			Let t.Index = t.Index + 1
			If t.Index = t.Length Then
				If t.Loop Then
					let t.Index = 0
				Else
					let t.Index = -1
				End If
			End If
		End If
	End If
End Sub

Sub Ticker_Reset (t As Ticker)
	let t.TickCnt = 0
	let t.Index = 0
End Sub

Function Ticker_IsRunning% (t as Ticker)
	if t.Index < 0 Then
		let Ticker_IsRunning% = FALSE
	else
		let Ticker_IsRunning% = TRUE
	end if
End Function

Function Ticker_IsFinished% (t as Ticker)
	if t.Index < 0 Then
		let Ticker_IsFinished% = TRUE
	else
		let Ticker_IsFinished% = FALSE
	end if
End Sub

' :mode=visualbasic: